# Copia este archivo como .env y completa SOLO los valores que necesites.
# NUNCA subas .env al repositorio.

# Django
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.vercel.app

# Base de datos (Supabase Postgres). Si se deja vacía se usa SQLite local.
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_RECEIPTS_BUCKET=payment-receipts
SUPABASE_DESIGNS_BUCKET=custom-designs

# Datos públicos del negocio (se muestran en la tienda y en el correo)
WHATSAPP_NUMBER=
BUSINESS_ADDRESS=Calle Groenlandia 2350, Cerrillos
BANK_NAME=Banco Estado
BANK_ACCOUNT_TYPE=Cuenta Vista
BANK_RUT=
BANK_ACCOUNT=

# Correo Resend
# Destinatario del aviso de compra. Por defecto: ctorresj@utem.cl
ADMIN_EMAIL=ctorresj@utem.cl
# Remitente verificado en Resend.
DEFAULT_FROM_EMAIL=Volantines Strong <onboarding@resend.dev>
RESEND_API_KEY=
# Opcional: bloquear backend manualmente. Si no se define, se usa Resend
# cuando RESEND_API_KEY existe y consola cuando no.
# EMAIL_BACKEND=

# Vercel (CLI / despliegue no interactivo)
# Pega aquí tu token de Vercel (https://vercel.com/account/tokens).
VERCEL_TOKEN=
# Se obtienen con `vercel link` o desde Project Settings > General.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
