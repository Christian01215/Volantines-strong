# =============================================================
# PLANTILLA DE ENTORNO — copiar a .env y completar
# NUNCA subir .env al repositorio. .env.example sí se versiona.
# Para cargar todo en Vercel:  powershell -File scripts/sync_vercel_env.ps1
# =============================================================

# ----------------------------- Django -------------------------
# Generar con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=.vercel.app,volantines-strong.vercel.app,localhost,127.0.0.1

# -------------------------- Base de datos ----------------------
# Supabase > Project Settings > Database > Connection string
# Usar SIEMPRE la cadena "Transaction pooler" (puerto 6543) en Vercel.
# Formato:
# postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ----------------------- Supabase API / Storage ----------------
# URL: Supabase > Project Settings > API > Project URL
# KEY: Supabase > Project Settings > API > Project API keys
#      usar SOLO la fila "service_role" / "secret key"
#      (sb_secret_... o el JWT legacy eyJ...). NUNCA la anon/publishable.
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_KEY=
# Buckets: Supabase > Storage > Buckets (deben existir y ser públicos).
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_RECEIPTS_BUCKET=payment-receipts
SUPABASE_DESIGNS_BUCKET=custom-designs
# En Vercel debe ser False: el filesystem es efímero.
ALLOW_LOCAL_STORAGE_FALLBACK=False

# ---------------------- Datos del negocio ----------------------
WHATSAPP_NUMBER=569XXXXXXXX
BUSINESS_ADDRESS=Calle Groenlandia 2350, Cerrillos
BANK_NAME=Banco Estado
BANK_ACCOUNT_TYPE=Cuenta Vista
BANK_RUT=XX.XXX.XXX-X
BANK_ACCOUNT=XXXXXXXX

# ----------------------------- Correo --------------------------
# Resend > API Keys. Para enviar a terceros hace falta dominio verificado.
ADMIN_EMAIL=ctorresj@utem.cl
DEFAULT_FROM_EMAIL=Volantines Strong <onboarding@resend.dev>
RESEND_API_KEY=
# No definir EMAIL_BACKEND: el código elige Resend o consola automáticamente.
# EMAIL_BACKEND=
# Mientras no haya dominio verificado en Resend, mantener en False.
SEND_CUSTOMER_CONFIRMATION=False

# ------------------ SOLO LOCAL / CLI de Vercel ------------------
# Estas tres variables NO se suben como variables del proyecto Vercel.
# Se obtienen con `vercel login` y `vercel link`.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
